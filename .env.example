# ---------------------------------------------------------------------------
# realestate-voice-agent configuration (copy to .env)
# NEVER put real credentials in this file or in git. Use environment variables,
# AWS IAM roles or AWS Secrets Manager in production.
# ---------------------------------------------------------------------------

# General
AWS_REGION=ca-central-1
AGENT_ID=realestate_001
LOG_DIR=logs
SKILL_STORE=local                # local | s3
SKILL_ROOT=skills                 # local skill root (SKILL_STORE=local)
SKILL_BUCKET=                     # required when SKILL_STORE=s3
DYNAMODB_TABLE=                   # optional; empty = JSONL file logging only

# LLM provider: bedrock (default) | openai | gemini | mock
MODEL_PROVIDER=bedrock
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
OPENAI_MODEL_ID=gpt-4o-mini
GEMINI_MODEL_ID=gemini-2.0-flash
# Third-party keys come from the environment / AgentCore identity vault, never from git:
OPENAI_API_KEY=
GEMINI_API_KEY=

# Voice: stt/tts provider: mock (tests, offline) | aws
STT_PROVIDER=mock
TTS_PROVIDER=mock
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=neural

# Routing confidence
SKILL_ACTIVATE_THRESHOLD=0.75
SKILL_CLARIFY_THRESHOLD=0.45

# Resilience
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2

# Telephony (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURE=false   # true in production
PUBLIC_BASE_URL=                  # e.g. https://example.com (public HTTPS URL for webhooks)

# AgentCore / deployment
AGENTCORE_RUNTIME_NAME=realestate-voice-agent
