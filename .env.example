# ---------------------------------------------------------------------------
# realestate-voice-agent configuration (copy to .env)
# NEVER put real credentials in this file or in git. Use environment variables,
# AWS IAM roles or AWS Secrets Manager in production.
# ---------------------------------------------------------------------------

# General
AWS_REGION=ca-central-1
# Alternative to IAM roles for local/dev use (keep out of git):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AGENT_ID=realestate_001
LOG_DIR=logs
SKILL_STORE=local                # local | s3
SKILL_ROOT=skills                 # local skill root (SKILL_STORE=local)
SKILL_BUCKET=                     # required when SKILL_STORE=s3
DYNAMODB_TABLE=                   # optional; empty = JSONL file logging only

# LLM provider: gemini (default) | bedrock | openai | mock
MODEL_PROVIDER=gemini
GEMINI_MODEL_ID=gemini-2.0-flash
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
OPENAI_MODEL_ID=gpt-4o-mini
# Third-party keys come from the environment / AgentCore identity vault, never from git:
GEMINI_API_KEY=
OPENAI_API_KEY=

# Voice: stt/tts provider: mock (tests, offline) | aws
STT_PROVIDER=mock
TTS_PROVIDER=mock
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=neural

# Routing confidence
SKILL_ACTIVATE_THRESHOLD=0.75
SKILL_CLARIFY_THRESHOLD=0.45

# Resilience
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2

# Telephony — SignalWire (Canadian/US longcode)
# The voice webhook points at POST /signalwire/voice; the media stream is
# served on wss://YOUR_HOST/signalwire/media (agent id travels as <Parameter>).
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_TOKEN=
SIGNALWIRE_VALIDATE=false        # true in production (HTTP Basic auth check)

# Telephony — Twilio (alternative provider)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURE=false   # true in production
PUBLIC_BASE_URL=                  # e.g. https://example.com (public HTTPS origin)

# AgentCore / deployment
AGENTCORE_RUNTIME_NAME=realestate-voice-agent
