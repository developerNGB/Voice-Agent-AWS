{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TwilioWebhookSecrets",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": ["arn:aws:secretsmanager:YOUR_REGION:YOUR_ACCOUNT_ID:secret:voice-agent/twilio-*"]
    },
    {
      "Sid": "SessionLookupsOnly",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:Query"],
      "Resource": ["arn:aws:dynamodb:YOUR_REGION:YOUR_ACCOUNT_ID:table/YOUR_TABLE_NAME"]
    }
  ]
}
